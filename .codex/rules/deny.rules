# sync-devin-codex が .claude/settings.json の permissions.deny から生成した。手で編集しない。
# prefix_rule は引数列の前方一致で、位置を指定しない一致（引数の後ろに現れるフラグ等）は表現できない。
# ファイル読み取りコマンドのglobは、同期時点で存在するファイル名に展開している。新しい秘密情報ファイルを追加したら再同期する。

prefix_rule(
    pattern = ["cat", [".env", ".env.sample", "./.env", "./.env.sample"]],
    decision = "forbidden",
    justification = "Claude Codeの permissions.deny に合わせて禁止: Bash(cat .env*)",
    match = ["cat .env"],
    not_match = ["cat README.md"],
)

prefix_rule(
    pattern = ["cat", [".env", ".env.sample", "mobile/.env.local", "mobile/.env.sample", "./.env", "./.env.sample", "./mobile/.env.local", "./mobile/.env.sample"]],
    decision = "forbidden",
    justification = "Claude Codeの permissions.deny に合わせて禁止: Bash(cat **/.env*)",
    match = ["cat .env"],
    not_match = ["cat README.md"],
)

prefix_rule(
    pattern = ["cat", ["mobile/android/_ci-debug.keystore", "./mobile/android/_ci-debug.keystore"]],
    decision = "forbidden",
    justification = "Claude Codeの permissions.deny に合わせて禁止: Bash(cat **/*.keystore)",
    match = ["cat mobile/android/_ci-debug.keystore"],
    not_match = ["cat README.md"],
)

prefix_rule(
    pattern = ["rm", "-rf"],
    decision = "forbidden",
    justification = "Claude Codeの permissions.deny に合わせて禁止: Bash(rm -rf *)",
    match = ["rm -rf"],
    not_match = ["rm"],
)

prefix_rule(
    pattern = ["rm", "-fr"],
    decision = "forbidden",
    justification = "Claude Codeの permissions.deny に合わせて禁止: Bash(rm -fr *)",
    match = ["rm -fr"],
    not_match = ["rm"],
)

prefix_rule(
    pattern = ["git", "push", "--force"],
    decision = "forbidden",
    justification = "Claude Codeの permissions.deny に合わせて禁止: Bash(git push --force*)",
    match = ["git push --force"],
    not_match = ["git push"],
)

prefix_rule(
    pattern = ["git", "push", "-f"],
    decision = "forbidden",
    justification = "Claude Codeの permissions.deny に合わせて禁止: Bash(git push -f*)",
    match = ["git push -f"],
    not_match = ["git push"],
)

prefix_rule(
    pattern = ["git", "push", "origin", "main", "--force"],
    decision = "forbidden",
    justification = "Claude Codeの permissions.deny に合わせて禁止: Bash(git push origin main --force*)",
    match = ["git push origin main --force"],
    not_match = ["git push origin main"],
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "Claude Codeの permissions.deny に合わせて禁止: Bash(git reset --hard*)",
    match = ["git reset --hard"],
    not_match = ["git reset"],
)

prefix_rule(
    pattern = ["git", "clean", "-fd"],
    decision = "forbidden",
    justification = "Claude Codeの permissions.deny に合わせて禁止: Bash(git clean -fd*)",
    match = ["git clean -fd"],
    not_match = ["git clean"],
)

prefix_rule(
    pattern = ["git", "branch", "-D"],
    decision = "forbidden",
    justification = "Claude Codeの permissions.deny に合わせて禁止: Bash(git branch -D*)",
    match = ["git branch -D"],
    not_match = ["git branch"],
)

prefix_rule(
    pattern = ["sudo"],
    decision = "forbidden",
    justification = "Claude Codeの permissions.deny に合わせて禁止: Bash(sudo *)",
    match = ["sudo"],
)

prefix_rule(
    pattern = ["chmod", "-R", "777"],
    decision = "forbidden",
    justification = "Claude Codeの permissions.deny に合わせて禁止: Bash(chmod -R 777*)",
    match = ["chmod -R 777"],
    not_match = ["chmod -R"],
)
