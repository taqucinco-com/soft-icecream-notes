{
  "permissions": {
    "deny": [
      "Exec(cat .env.local)",
      "Exec(cat key.properties)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(**/key.properties)",
      "Read(**/local.properties)",
      "Read(**/google-services.json)",
      "Read(**/GoogleService-Info.plist)",
      "Read(**/secrets.yaml)",
      "Read(**/secrets.json)",
      "Write(./.env)",
      "Write(./.env.*)",
      "Write(**/.env)",
      "Write(**/.env.*)",
      "Write(**/*.pem)",
      "Write(**/*.key)",
      "Write(**/*.p12)",
      "Write(**/*.jks)",
      "Write(**/*.keystore)",
      "Write(**/key.properties)",
      "Write(**/local.properties)",
      "Write(**/google-services.json)",
      "Write(**/GoogleService-Info.plist)",
      "Write(**/secrets.yaml)",
      "Write(**/secrets.json)",
      "Exec(cat .env)",
      "Exec(cat .env.sample)",
      "Exec(cat mobile/.env.local)",
      "Exec(cat mobile/.env.sample)",
      "Exec(cat mobile/android/_ci-debug.keystore)",
      "Exec(rm -rf)",
      "Exec(rm -fr)",
      "Exec(git push --force)",
      "Exec(git push -f)",
      "Exec(git push origin main --force)",
      "Exec(git reset --hard)",
      "Exec(git clean -fd)",
      "Exec(git branch -D)",
      "Exec(sudo)",
      "Exec(chmod -R 777)"
    ]
  }
}
